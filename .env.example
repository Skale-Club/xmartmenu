# Supabase
# Legacy source settings during transition. These are NOT a development target.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use the transaction pooler URL from Project Settings > Database > Connection string > Transaction (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres
# CLI credentials (for `supabase` CLI commands without interactive login)
SUPABASE_ACCESS_TOKEN=sbp_xxx
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_PROJECT_REF=your-project-ref

# Isolated Supabase development project. Never reuse the production source.
DEV_SUPABASE_PROJECT_REF=
DEV_SUPABASE_URL=
DEV_SUPABASE_ANON_KEY=
DEV_SUPABASE_SERVICE_ROLE_KEY=
DEV_DATABASE_URL=
# Optional direct/session-pooler connection for DDL when DEV_DATABASE_URL uses 6543.
DEV_MIGRATION_DATABASE_URL=

# Independent production PostgreSQL. No fallback to DATABASE_URL.
PROD_MIGRATION_DATABASE_URL=
PROD_DATABASE_HOST=
PROD_DATABASE_NAME=

# Independent public root appearance reader only; legacy remains the default.
OWNED_PLATFORM_APPEARANCE_ENABLED=false
# Dedicated least-privilege login: SELECT(cta_color, favicon_url) only on
# public.platform_settings. No migration/import or legacy fallback is automatic.
PLATFORM_APPEARANCE_DATABASE_URL=
PLATFORM_APPEARANCE_DATABASE_SSL=require
# Public menu/catalog repository. Default remains the existing reader. The own
# path never falls back to Supabase and needs the same restored host/database.
OWNED_PUBLIC_MENU_ENABLED=false
PUBLIC_MENU_DATABASE_URL=
PUBLIC_MENU_DATABASE_SSL=require
# Full admin menu lifecycle only. Keep off until catalog/writer reconciliation,
# actor authorization and downstream catalog consumers are verified together.
OWNED_ADMIN_MENUS_ENABLED=false
ADMIN_MENUS_DATABASE_URL=
ADMIN_MENUS_DATABASE_SSL=require
# Ingredient catalog CRUD uses the same ADMIN_MENUS connection pool/target.
# Keep off until catalog readers and writers share the final production target.
OWNED_ADMIN_CATALOG_ENABLED=false

# Orders checkout/KDS data only. Existing Auth and payment handlers remain separate.
# Requires the exact restored atomic create_order_with_items(jsonb,jsonb) function
# and runtime EXECUTE/DML privileges; no grants/import/fallback are automatic.
OWNED_ORDER_DATA_ENABLED=false
ORDERS_DATABASE_URL=
ORDERS_DATABASE_SSL=require

# Checkout/order-payment data only; enable jointly with OWNED_ORDER_DATA_ENABLED.
# SaaS subscriptions/Connect OAuth remain legacy until their separate migration.
OWNED_PAYMENT_DATA_ENABLED=false
PAYMENTS_DATABASE_URL=
PAYMENTS_DATABASE_SSL=require

# Opt-in identity pilot only; keep false until isolated and real-provider gates.
GOOGLE_AUTH_ENABLED=false
# Core guards/profile/shell only. Keep false until remaining authenticated data
# consumers and real phone/Google login acceptance are complete.
OWNED_AUTH_ENABLED=false
# Remaining boundaries, all off. Owned mode = ANY OWNED_*_ENABLED flag is true:
# platform_settings, tenant lookup by custom domain, SEO, health, superadmin
# launch checklist then use the own PostgreSQL (ADMIN_MENUS_* target), never
# Supabase, and STORAGE_PROVIDER=s3 becomes mandatory (the app refuses to boot).
OWNED_ACCOUNT_ADMIN_ENABLED=false
OWNED_TENANT_ADMIN_ENABLED=false
OWNED_TENANT_EFFECTS_ENABLED=false
OWNED_MCP_ENABLED=false
OWNED_REGISTRATION_ENABLED=false
OWNED_ONBOARDING_ENABLED=false
OWNED_ADMIN_WAITER_CALLS_ENABLED=false
GOOGLE_AUTH_PROJECT_ID=skaleclub
GOOGLE_AUTH_PROJECT_NUMBER=937861185231
GOOGLE_AUTH_WEB_API_KEY=
# Development Google Auth must be a separate, explicitly reviewed project.
# ID and number must both differ from production. The public config endpoint
# verifies API-key ownership before any mutable browser authentication call.
DEV_GOOGLE_AUTH_PROJECT_ID=
DEV_GOOGLE_AUTH_PROJECT_NUMBER=
DEV_GOOGLE_AUTH_WEB_API_KEY=
IDENTITY_ORIGIN=
# Runtime PostgreSQL URL is explicit and independent in production. Development
# uses the guarded DEV_DATABASE_URL above, never the legacy DATABASE_URL.
IDENTITY_DATABASE_URL=
IDENTITY_DATABASE_SSL=require
# Google credentials come from ADC/workload federation. Do not generate JSON
# private keys or copy a short-lived Codex token into the server environment.

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com
SUPERADMIN_EMAILS=admin@example.com,other@example.com

# MCP server (owner-level platform management via Claude / Codex over OAuth).
# Endpoint: /api/mcp. Auth = Supabase OAuth 2.1 access token, gated to superadmins.
# Destructive delete tools stay OFF unless this is exactly "true" (and each call
# still requires confirm:true). Leave empty to keep deletes disabled.
MCP_ALLOW_DESTRUCTIVE=
# Optional: force the public origin used in the OAuth resource metadata when the
# reverse proxy does not forward X-Forwarded-Host / X-Forwarded-Proto.
# Default: auto-detected from proxy headers (correct behind Coolify/traefik).
MCP_PUBLIC_ORIGIN=

# Public demo (/demo signs visitors into the sample restaurant's admin as owner)
# Optional: defaults are used if unset. The /demo route resets this account's
# password on every visit, so it is a sandbox owner, not a real credential.
# /demo sets the owner password and signs in within the same request, so it uses a
# fresh random password per hit. DEMO_OWNER_PASSWORD (>= 12 chars) is optional and
# only pins it. In owned mode /demo answers 503 (it would create a Supabase Auth user).
DEMO_OWNER_EMAIL=demo-owner@xmartmenu.local
DEMO_OWNER_PASSWORD=
DEFAULT_STAFF_PASSWORD=

# AI — everything goes through OpenRouter (src/lib/ai/openrouter.ts).
# Platform key: superadmin seed, menu OCR, seed images, menu translation.
# Restaurants' chat, voice notes and blogs use their own OpenRouter keys.
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional overrides (OpenRouter model slugs). Defaults in openrouter.ts.
# OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
# OPENROUTER_IMAGE_ENGINE=google            # google (Gemini Image) | openai (GPT Image)
# OPENROUTER_IMAGE_MODEL_GOOGLE=google/gemini-3.1-flash-image
# OPENROUTER_IMAGE_MODEL_OPENAI=openai/gpt-image-2
# OPENROUTER_TRANSCRIPTION_MODEL=           # forces one model; default follows the restaurant's choice

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CLIENT_ID=ca_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dedicated HMAC key for Stripe Connect OAuth state (generate: openssl rand -hex 32).
# Falls back to STRIPE_WEBHOOK_SECRET if unset, but a dedicated key is recommended.
OAUTH_STATE_SECRET=
# Stripe Price ID for the AI Chat Addon ($20/month). Required only if the addon is sold.
STRIPE_CHAT_ADDON_PRICE_ID=
# Plan subscription Price IDs live in the DB (plans table) — run `npm run stripe:setup-plans`.

# Storage - S3 provider (Cloudflare R2 in production; unset = Supabase Storage)
# Set STORAGE_PROVIDER=s3 to activate. {bucket} in the public URL base is replaced
# with the resolved bucket name, so one var covers both buckets. Each bucket is
# served by an R2 custom domain of the same name on the skale.club zone.
STORAGE_PROVIDER=
STORAGE_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_URL_BASE=https://{bucket}.skale.club
STORAGE_S3_BUCKET_TENANT_ASSETS=xmartmenu-tenant-assets
STORAGE_S3_BUCKET_PRODUCT_IMAGES=xmartmenu-product-images

# GitHub seed image import - optional
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GH_PAT=

# Rate limiting (Upstash Redis) - optional; rate limiting fails OPEN until BOTH are set
# Create a database at https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Chat addon encryption - required only if the AI chat addon is enabled
# Must be 32 bytes; generate with: openssl rand -hex 32
CHAT_ADDON_ENCRYPTION_KEY=

# Error tracking & security-event alerting (Sentry) - optional; inert until set.
# Create a project at https://sentry.io and copy the DSN.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed to upload source maps during the build (optional):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Xphere CRM Sync (v2.4) - optional; sync ships DARK until configured.
# ALL vars below are SERVER-ONLY — never prefix any of them with NEXT_PUBLIC_
# (these are secrets / internal config and must not reach the browser bundle).
# The sync stays a no-op until XPHERE_API_URL + XPHERE_API_KEY are set AND
# XPHERE_SYNC_ENABLED=true (the kill switch). Placeholders only here (gitleaks-safe).
XPHERE_API_URL=
XPHERE_API_KEY=
XPHERE_ORG_ID=e375f031-4d9a-42b1-9f3c-ade805650442
# QStash (Upstash) — durable delivery + signed worker callbacks.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Kill switch: leave empty/false to keep sync dark; set to `true` to activate.
XPHERE_SYNC_ENABLED=
# Pinned public worker URL for QStash signature verify — MUST match the publish
# URL exactly (never derive from req.url; the Coolify proxy rewrites host/scheme).
XPHERE_WORKER_URL=https://xmartmenu.skale.club/api/internal/xphere-sync

# Public menu cache (src/lib/menu/public-menu-cache.ts). The menu data is kept
# for this many seconds per restaurant; admin writes drop it at once. 0 = off.
PUBLIC_MENU_CACHE_SECONDS=60
# Shared secret for POST /api/internal/revalidate-menu (seed scripts, SQL by
# hand, e2e fixtures). Unset = the route does not exist. openssl rand -hex 32
MENU_REVALIDATE_SECRET=
