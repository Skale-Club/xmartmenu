{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/test-self",
        "http://localhost:3100/test-menu"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.88, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
